{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "capture",
  "version": "0.1.0",
  "identifier": "edu.nyu.kiabai.trackpad",
  "build": {
    "beforeDevCommand": "pnpm --dir ../form-study dev",
    "devUrl": "http://localhost:5174",
    "beforeBuildCommand": "pnpm --dir ../form-study exec vite build",
    "frontendDist": "../../form-study/dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Trackpad",
        "width": 512,
        "height": 380,
        "resizable": false,
        "alwaysOnTop": true,
        "acceptFirstMouse": true,
        "url": "window.html"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
